# ==============================================================
# LM Studio / Bionic Connection Configuration
# ==============================================================
# Security Notice: 
# Copy this file to '.env' and fill in your actual connection details.
# NEVER commit your '.env' file to GitHub (it is ignored by .gitignore).
# ==============================================================

# The endpoint where your LM Studio local server is running.
# Examples:
# - Default LM Studio: http://localhost:1234/v1
# - Custom machine name / IP: http://bionic:1234/v1 or http://192.168.1.50:1234/v1
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# LM Studio does not require an API key by default, but the OpenAI client
# expects a non-empty string. You can leave this as 'lm-studio'.
LM_STUDIO_API_KEY=lm-studio

# Model name:
# By default, LM Studio serves whatever model is currently loaded in its local server.
# You can leave this as 'default' or specify the model identifier from LM Studio.
LM_STUDIO_MODEL=default

# System Prompt to guide the assistant's persona and behavior
SYSTEM_PROMPT=You are a helpful, thoughtful, and knowledgeable AI assistant running locally. Keep your answers concise, accurate, and structured.

# Model parameters
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
